# copy -> .env  và đổi giá trị. .env KHÔNG commit (đã có trong .gitignore).

# key nội bộ vision-api <-> backend
INTERNAL_KEY=dev-internal-key

# tenant seed sẵn trong mock-backend (csv)
SEED_TENANTS=t_demo

# token API cho client. JSON compact 1 dòng.
#   "*"    = token global, bắt buộc gửi header X-Tenant-ID
#   role   = client | admin   (admin mới gọi được /admin/reload)
VISION_API_TOKENS={"tok_demo_client":{"tenant":"t_demo","role":"client"},"tok_admin_root":{"tenant":"*","role":"admin"}}

# --- modality bật/tắt ---
VISION_ENABLE_FACE=true
VISION_ENABLE_PRODUCTS=true

# --- face (InsightFace) ---
INSIGHTFACE_MODEL=buffalo_l
DET_SIZE=640
MATCH_THRESHOLD=0.40
TOP_K=5

# --- product visual search (DINOv2-S, 1 ảnh = 1 sp) ---
PRODUCT_MODEL=dinov2-small
PRODUCT_MATCH_THRESHOLD=0.55      # PHẢI calibrate trên catalog thật
PRODUCT_TOP_K=5
# mock-backend cần khớp dim:
PRODUCT_EMB_DIM=384

VISION_RATE_LIMIT_PER_MIN=120

# --- backend thật (thay mock-backend) ---
# VISION_BACKEND_URL=https://<dashboard>.pages.dev
# VISION_TOKENS_FROM_BACKEND=true   # lấy token client từ dashboard (GET /internal/api-tokens)

# --- SSRF / giới hạn ảnh ---
# tắt hẳn tải ảnh theo URL (chỉ nhận upload) -> an toàn nhất cho production:
VISION_ALLOW_URL_FETCH=true
# giới hạn URL theo domain (csv), rỗng = cho mọi domain public (vẫn chặn IP nội bộ):
VISION_URL_ALLOWLIST=
VISION_MAX_IMAGE_BYTES=20971520
VISION_MAX_IMAGE_PIXELS=40000000

# --- metrics ---
VISION_METRICS_ENABLED=true
