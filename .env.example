# copy -> .env  và đổi giá trị. .env KHÔNG commit (đã có trong .gitignore).

# key nội bộ vision-api <-> backend
INTERNAL_KEY=dev-internal-key

# tenant seed sẵn trong mock-backend (csv)
SEED_TENANTS=t_demo

# token API cho client. JSON compact 1 dòng.
#   "*"    = token global, bắt buộc gửi header X-Tenant-ID
#   role   = client | admin   (admin mới gọi được /admin/reload)
VISION_API_TOKENS={"tok_demo_client":{"tenant":"t_demo","role":"client"},"tok_admin_root":{"tenant":"*","role":"admin"}}

# model / matching
INSIGHTFACE_MODEL=buffalo_l
DET_SIZE=640
MATCH_THRESHOLD=0.40
TOP_K=5

VISION_RATE_LIMIT_PER_MIN=120
